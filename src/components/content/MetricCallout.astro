---
interface Metric {
	value: string;
	label: string;
}

interface Props {
	items: Metric[];
	ariaLabel?: string;
}

const { items, ariaLabel = 'Key metrics' } = Astro.props;
---

<dl class="metric-callout" aria-label={ariaLabel}>
	{items.map(({ value, label }) => (
		<div class="metric">
			<dt>{label}</dt>
			<dd>{value}</dd>
		</div>
	))}
</dl>

<style>
	.metric-callout {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		margin: 0;
		color: var(--theme-dark, var(--color-text));
	}

	.metric {
		display: flex;
		min-width: 0;
		flex-direction: column-reverse;
		gap: var(--space-xs);
		padding-inline: clamp(var(--space-sm), 2vw, var(--space-xl));
		text-align: center;
	}

	.metric:first-child {
		padding-left: 0;
	}

	.metric:last-child {
		padding-right: 0;
	}

	.metric + .metric {
		border-left: 1px solid var(--tone-foreground, var(--color-border));
	}

	.metric dt,
	.metric dd {
		margin: 0;
	}

	.metric dt {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 650;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.metric dd {
		font-family: var(--font-display);
		font-size: var(--font-size-2xl);
		font-variation-settings:
			"SOFT" 80,
			"WONK" 1,
			"opsz" 72;
		font-weight: 650;
		line-height: 1;
		text-wrap: balance;
	}

	@media (max-width: 42rem) {
		.metric-callout {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: var(--space-lg);
		}

		.metric {
			padding-inline: var(--space-md);
		}

		.metric:nth-child(odd) {
			padding-left: 0;
			border-left: 0;
		}

		.metric:nth-child(even) {
			padding-right: 0;
		}

		.metric:nth-child(n + 3) {
			padding-top: var(--space-lg);
			border-top: 1px solid var(--tone-foreground, var(--color-border));
		}
	}

	@media (max-width: 26rem) {
		.metric-callout {
			grid-template-columns: 1fr;
			row-gap: 0;
		}

		.metric,
		.metric:first-child,
		.metric:last-child {
			padding: var(--space-lg) 0;
			border-left: 0;
		}

		.metric:first-child {
			padding-top: 0;
		}

		.metric:last-child {
			padding-bottom: 0;
		}

		.metric + .metric {
			border-top: 1px solid var(--tone-foreground, var(--color-border));
		}
	}
</style>
