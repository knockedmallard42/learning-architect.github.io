---
export interface FlowItem {
  title: string;
  description?: string;
  label?: string;
  children?: FlowItem[];
}

interface Props {
  items: FlowItem[];
  variant?: 'flow' | 'tree';
  ariaLabel?: string;
  depth?: number;
}

const {
  items,
  variant = 'flow',
  ariaLabel,
  depth = 0,
} = Astro.props;

const isRoot = depth === 0;
---

<ul
  class:list={[
    'flow-list',
    `flow-list--${variant}`,
    { 'flow-list--root': isRoot },
  ]}
  aria-label={isRoot ? ariaLabel : undefined}
>
  {
    items.map((item) => (
      <li class="flow-item">
        <span class="flow-marker" aria-hidden="true"></span>

        <div class="flow-content">
          {item.label && <span class="flow-label">{item.label}</span>}
          <h3>{item.title}</h3>
          {item.description && <p>{item.description}</p>}
        </div>

        {item.children?.length && (
          <Astro.self
            items={item.children}
            variant={variant}
            depth={depth + 1}
          />
        )}
      </li>
    ))
  }
</ul>

<style>
  .flow-list {
    --flow-marker-size: 0.8rem;
    --flow-rail-position: calc(var(--flow-marker-size) / 2);
    --flow-arrow-size: 0.42rem;

    display: grid;
    gap: var(--space-md);

    margin: var(--space-md) 0 0 var(--flow-rail-position);
    padding: 0 0 0 var(--space-xl);
    border-left: 0.12rem solid var(--theme-light);

    list-style: none;
  }

  .flow-list--root {
    max-width: var(--reading-width);
    margin: 0;
    padding-left: 0;
    border-left: 0;
  }

  .flow-item {
    position: relative;
    display: grid;
    grid-template-columns: var(--flow-marker-size) minmax(0, 1fr);
    column-gap: var(--space-md);
  }

  .flow-list:not(.flow-list--root) > .flow-item::before {
    content: '';
    position: absolute;
    top: var(--flow-rail-position);
    right: calc(100% + var(--flow-marker-size));
    width: var(--space-xl);
    border-top: 0.12rem solid var(--theme-light);
  }

  .flow-list--flow.flow-list--root > .flow-item:not(:last-child)::before {
    content: '';
    position: absolute;
    top: var(--flow-marker-size);
    bottom: calc(var(--space-md) * -1);
    left: var(--flow-rail-position);
    border-left: 0.12rem solid var(--theme-light);
  }

  .flow-list--flow.flow-list--root > .flow-item:not(:last-child)::after {
    content: '';
    position: absolute;
    bottom: calc(var(--space-md) * -1);
    left: var(--flow-rail-position);
    width: var(--flow-arrow-size);
    height: var(--flow-arrow-size);
    border-right: 0.12rem solid var(--theme-medium);
    border-bottom: 0.12rem solid var(--theme-medium);
    transform: translateX(-50%) rotate(45deg);
  }

  .flow-marker {
    position: relative;
    z-index: 1;
    width: var(--flow-marker-size);
    height: var(--flow-marker-size);
    margin-top: 0.52rem;
    border: 0.15rem solid var(--theme-dark);
    border-radius: 50%;
    background: var(--color-background);
  }

  .flow-list--tree > .flow-item > .flow-marker {
    border-radius: 0.2rem;
    background: var(--theme-soft);
  }

  .flow-content {
    min-width: 0;
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--theme-light);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .flow-list--tree .flow-content {
    padding: var(--space-sm) var(--space-md);
    box-shadow: none;
  }

  .flow-content h3 {
    margin: 0;
    color: var(--theme-dark);
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    line-height: 1.3;
  }

  .flow-label {
    display: block;
    margin-bottom: var(--space-2xs);
    color: var(--theme-dark);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .flow-content p {
    margin: var(--space-xs) 0 0;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .flow-item > .flow-list {
    grid-column: 2;
  }

  @media (max-width: 35rem) {
    .flow-list {
      padding-left: var(--space-lg);
    }

    .flow-list:not(.flow-list--root) > .flow-item::before {
      width: var(--space-lg);
    }

    .flow-content {
      padding: var(--space-sm) var(--space-md);
    }
  }
</style>
