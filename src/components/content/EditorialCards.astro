---
export interface EditorialCard {
	number?: string | number;
	title: string;
	description: string;
}

interface Props {
	cards: EditorialCard[];
	ariaLabel?: string;
}

const {
	cards,
	ariaLabel = 'Editorial cards',
} = Astro.props;

if (cards.length < 3 || cards.length > 10) {
	throw new RangeError(
		`EditorialCards requires between 3 and 10 cards; received ${cards.length}.`,
	);
}
---

<div class="editorial-cards" role="list" aria-label={ariaLabel}>
	{
		cards.map((card) => (
			<article class="editorial-card" role="listitem">
				{card.number !== undefined && (
					<span class="editorial-card__number">
						{card.number}
					</span>
				)}

				<div class="editorial-card__content">
					<h3>{card.title}</h3>
					<p>{card.description}</p>
				</div>
			</article>
		))
	}
</div>

<style>
	.editorial-cards {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: var(--space-lg);
	}

	.editorial-card {
		display: flex;
		flex-direction: column;
		grid-column: span 5;
		min-height: 14rem;
		padding: clamp(1.5rem, 4vw, 2.75rem);
		border-radius: var(--radius-xl);
		background: var(--color-steel-100);
		box-shadow: var(--shadow-sm);
	}

	.editorial-card:nth-child(4n + 1) {
		grid-column: span 7;
		background: var(--color-steel-100);
	}

	.editorial-card:nth-child(4n + 2) {
		margin-top: var(--space-xl);
		background: var(--color-sage-100);
	}

	.editorial-card:nth-child(4n + 3) {
		background: var(--color-plum-100);
	}

	.editorial-card:nth-child(4n + 4) {
		grid-column: span 7;
		margin-top: calc(var(--space-xl) * -1);
		background: var(--color-gold-100);
	}

	.editorial-card__number {
		display: block;
		margin-bottom: var(--space-2xl);
		color: var(--color-granite-600);
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
	}

	.editorial-card__content {
		margin-top: auto;
	}

	.editorial-card h3 {
		font-family: var(--font-display);
		font-size: clamp(1.7rem, 4vw, 2.5rem);
		font-variation-settings:
			"SOFT" 60,
			"WONK" 1,
			"opsz" 48;
	}

	.editorial-card p {
		max-width: 34rem;
		margin-bottom: 0;
		color: var(--color-text-muted);
	}

	@media (max-width: 60rem) {
		.editorial-card:nth-child(n) {
			grid-column: span 6;
			margin-top: 0;
		}
	}

	@media (max-width: 45rem) {
		.editorial-cards {
			grid-template-columns: 1fr;
		}

		.editorial-card:nth-child(n) {
			grid-column: auto;
			min-height: auto;
		}

		.editorial-card__number {
			margin-bottom: var(--space-lg);
		}
	}
</style>
