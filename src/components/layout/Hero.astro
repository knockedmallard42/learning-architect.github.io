---
interface Props {
	eyebrow: string;
	title: string;
	description: string;
}

const {
	eyebrow,
	title,
	description,
} = Astro.props;
---

<section class="hero">
	<div class="container">
		<div class="reading-width">
			<p class="eyebrow">
				{eyebrow}
			</p>
			
			<h1>
				{title}
			</h1>
			
			<p class="description">
				{description}
			</p>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-block: clamp(4rem, 10vw, 8rem);
	}
	
	.eyebrow {
		margin-bottom: var(--space-md);
		color: var(--color-accent);
		font-size: 0.9rem;
		font-weight: 750;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	
	h1 {
		max-width: 18ch;
		font-size: clamp(2.5rem, 7vw, 5rem);
	}
	
	.description {
		max-width: 42rem;
		color: var(--color-text-muted);
		font-size: clamp(1.1rem, 2vw, 1.35rem);
	}
</style>