---
import ArtifactDialog from './ArtifactDialog.astro';
import Button from '../navigation/Button.astro';

interface Props {
  id: string;
  title: string;
  src: string;

  buttonLabel?: string;
  downloadLabel?: string;
  
  theme?: Theme;
}

const {
  id,
  title,
  src,
  buttonLabel = 'View PDF',
  downloadLabel = 'Open PDF directly',
  theme = 'steel',
} = Astro.props;
---

<Button
  linkLabel={buttonLabel}
  type="button"
  theme={theme}
  intent="minimal"
  dataArtifactOpen={id}
/>

<ArtifactDialog
  id={id}
  title={title}
  eyebrow="Document sample"
>
  <div class="pdf-viewer">
    <object
  class="pdf-frame"
  data={src}
  type="application/pdf"
  aria-label={title}
>
  <p>
    This browser couldn't display the PDF.
    <a href={src} target="_blank" rel="noopener">
      Open the PDF directly
    </a>
  </p>
</object>

    <div class="pdf-actions">
      <a
        href={src}
        target="_blank"
        rel="noopener"
      >
        {downloadLabel}
      </a>
    </div>
  </div>
</ArtifactDialog>

<style>
  .pdf-viewer {
    display: grid;
    grid-template-rows: 1fr auto;
    width: 100%;
    height: calc(96vh - 7rem);
  }

  .pdf-frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .pdf-actions {
    display: flex;
    justify-content: flex-end;

    padding: var(--space-md) var(--space-lg);

    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .pdf-actions a {
    color: var(--theme-dark);
    font-weight: 700;
    text-decoration: none;
  }
</style>